# ro.product.system.* is a distinct namespace from ro.product.* (bare) and
# ro.build.* above -- without this, Google's device-consistency check (the
# same one gms_spoof_vendor/odm/product/system_ext.prop fix for build.*)
# still saw the real Khadas/vim3/VIM3 Automotive identity here, which is
# what showed up as "manufacturer: Khadas" during Google sign-in instead
# of the spoofed "Google".
ro.product.system.brand=google
ro.product.system.device=emulator_car64_arm64
ro.product.system.manufacturer=Google
ro.product.system.model=car_generic
ro.product.system.name=car_generic
