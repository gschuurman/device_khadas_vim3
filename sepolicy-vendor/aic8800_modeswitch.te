type aic8800_modeswitch, domain;
type aic8800_modeswitch_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(aic8800_modeswitch)

allow aic8800_modeswitch self:netlink_kobject_uevent_socket { create bind read };

# The dongle's block device gets a dynamic name, so file_contexts can't
# pin it and it lands on the generic "block_device" type. domain.te
# neverallows raw blk_file access on that type outside core domains, so
# relabel to a type of our own at runtime instead (see
# aic8800_modeswitch.c).
type aic8800_block_device, dev_type;

allow aic8800_modeswitch block_device:blk_file relabelfrom;
allow aic8800_modeswitch aic8800_block_device:blk_file { relabelto getattr open ioctl };

# No sys_rawio: SG_IO's START_STOP command is on the kernel's own
# capability-free allowlist (scsi_cmd_allowed()), and it's neverallow'd
# for this domain anyway.
