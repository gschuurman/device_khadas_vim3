<?xml version="1.0" encoding="utf-8"?>
<mixerControls>
    <control function="MASTER_VOLUME" type="int">
        <name>Speaker Playback Volume</name>
        <name>Line Playback Volume</name>
        <name>PCM Playback Volume</name>
    </control>

    <control function="MASTER_SWITCH" type="bool">
        <name>Speaker Playback Switch</name>
        <name>Line Playback Switch</name>
        <name>Master Playback Switch</name>
    </control>

    <control function="MIC_GAIN" type="int">
        <name>Mic Capture Volume</name>
        <name>PCM Capture Volume</name>
    </control>

    <control function="MIC_SWITCH" type="bool">
        <name>Mic Capture Switch</name>
        <name>PCM Capture Switch</name>
    </control>

    <init>
        <set name="Line Playback Switch" value="0"/>
        <set name="Line Playback Volume" value="0"/>

        <set name="Mic Playback Switch" value="0"/>
        <set name="Mic Playback Volume" value="0"/>

        <set name="Speaker Playback Switch" value="1"/>
        <set name="Speaker Playback Volume" value="70"/>

        <set name="Mic Capture Switch" value="1"/>
        <set name="PCM Capture Switch" value="1"/>
    </init>
</mixerControls>