<?xml version="1.0" encoding="utf-8"?>
<mixerControls>
    <control function="MASTER_VOLUME" type="int">
        <name>Speaker Playback Volume</name>
        <name>Line Playback Volume</name>
        <name>PCM Playback Volume</name>
    </control>

    <control function="MASTER_SWITCH" type="bool">
        <name>Speaker Playback Switch</name>
        <name>Line Playback Switch</name>
        <name>Master Playback Switch</name>
    </control>

    <control function="MIC_GAIN" type="int">
        <name>Mic Capture Volume</name>
        <name>PCM Capture Volume</name>
    </control>

    <control function="MIC_SWITCH" type="bool">
        <name>Mic Capture Switch</name>
        <name>PCM Capture Switch</name>
    </control>

    <init>
        <!-- Car audio module (onboard card, TDM-B; see dai-link-8 in meson-khadas-vim3.dtsi).
             Playback: PCM 0 (FRDDR_A) -> TDMOUT_B -> front DAC (lane 0) + rear DAC (lane 1).
             HDMI (TDMOUT_A) is left without a source. -->
        <set name="FRDDR_A SINK 1 SEL" value="OUT 1"/>
        <set name="FRDDR_A SRC 1 EN Switch" value="1"/>
        <set name="TDMOUT_B SRC SEL" value="IN 0"/>
        <!-- Capture: TDM-B lane 3 (PCM1808 mic ADC) -> TDMIN_B -> TODDR_A = PCM 3. -->
        <set name="TDMIN_B SRC SEL" value="IN 1"/>
        <set name="TODDR_A SRC SEL" value="IN 1"/>
    </init>
</mixerControls>