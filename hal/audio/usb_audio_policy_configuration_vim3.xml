<devicePorts>
    <devicePort tagName="USB Device Out"
        type="AUDIO_DEVICE_OUT_USB_DEVICE"
        role="sink">

        <gains>
            <gain name="usb_device_gain"
                mode="AUDIO_GAIN_MODE_JOINT"
                channel_mask="AUDIO_CHANNEL_OUT_STEREO"
                min_value_mb="-6000"
                max_value_mb="0"
                default_value_mb="-2000"
                step_value_mb="100"
                minValueMB="-6000"
                maxValueMB="0"
                defaultValueMB="-2000"
                stepValueMB="100" />
        </gains>
    </devicePort>

    <devicePort tagName="USB Headset Out"
        type="AUDIO_DEVICE_OUT_USB_HEADSET"
        role="sink">

        <gains>
            <gain name="usb_headset_gain"
                mode="AUDIO_GAIN_MODE_JOINT"
                channel_mask="AUDIO_CHANNEL_OUT_STEREO"
                min_value_mb="-6000"
                max_value_mb="0"
                default_value_mb="-2000"
                step_value_mb="100"
                minValueMB="-6000"
                maxValueMB="0"
                defaultValueMB="-2000"
                stepValueMB="100" />
        </gains>
    </devicePort>
</devicePorts>