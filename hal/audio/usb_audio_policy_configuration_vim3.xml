<module name="usb" halVersion="2.0">
    <mixPorts>
        <mixPort name="usb_output" role="source">
            <profile format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="44100,48000"
                     channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </mixPort>
    </mixPorts>

    <devicePorts>
        <devicePort tagName="USB Device Out"
                    type="AUDIO_DEVICE_OUT_USB_DEVICE"
                    role="sink"/>
        <devicePort tagName="USB Headset Out"
                    type="AUDIO_DEVICE_OUT_USB_HEADSET"
                    role="sink"/>
    </devicePorts>

    <routes>
        <route type="mix" sink="USB Device Out" sources="usb_output"/>
        <route type="mix" sink="USB Headset Out" sources="usb_output"/>
    </routes>
</module>
