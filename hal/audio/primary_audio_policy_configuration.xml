<?xml version="1.0" encoding="UTF-8"?>
<module name="primary" halVersion="3.0">
    <!-- Car audio module (rev 0.6): onboard sound card, TDM-B. Every output is quad
         (FL FR BL BR = front DAC L/R, rear DAC L/R); the HAL copies the fronts to the
         rears when a stream leaves them silent (stereo content) and applies
         balance/fader. The mic is the PCM1808 ADC on the same card.
         96 kHz / 32-bit throughout: the highest rate at which the mic can record while
         music plays (capture and playback share the TDM-B clocks, the PCM1808 tops out
         at 96 kHz), and 32-bit headroom for the HAL's volume/EQ/balance processing.
         The PCM5102A takes 32-bit words up to 384 kHz. -->

    <attachedDevices>
        <item>bus0_media_out</item>
        <item>bus1_navigation_out</item>
        <item>bus2_voice_command_out</item>
        <item>bus3_call_ring_out</item>
        <item>bus4_call_out</item>
        <item>bus5_alarm_out</item>
        <item>bus6_notification_out</item>
        <item>bus7_system_sound_out</item>
        <item>Built-In Mic</item>
        <item>FM Tuner</item>
    </attachedDevices>

    <defaultOutputDevice>bus0_media_out</defaultOutputDevice>

    <mixPorts>
        <mixPort name="primary output"
                role="source"
                flags="AUDIO_OUTPUT_FLAG_PRIMARY">
            <!-- Quad: front + rear DAC -->
            <profile format="AUDIO_FORMAT_PCM_32_BIT"
                    samplingRates="96000"
                    channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>

        <!-- Built-in mic (PCM1808 on TDM-B, 24-bit in 32-bit words). Same rate as the
             outputs: capture shares the TDM-B clocks with playback; AudioFlinger
             resamples for 16 kHz clients such as the voice assistant. Mono = the mic
             channel. -->
        <mixPort name="primary input" role="sink">
            <profile format="AUDIO_FORMAT_PCM_32_BIT"
                     samplingRates="96000"
                     channelMasks="AUDIO_CHANNEL_IN_MONO AUDIO_CHANNEL_IN_STEREO"/>
        </mixPort>

        <!-- Native radio: capture port for the FM/DAB tuner (fed via snd-aloop Loopback). -->
        <mixPort name="fm_tuner input" role="sink">
            <profile format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="48000"
                     channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
        </mixPort>

        <mixPort name="mixport_bus0_media_out"
                role="source"
                flags="AUDIO_OUTPUT_FLAG_PRIMARY">
            <!-- Quad: front + rear DAC -->
            <profile format="AUDIO_FORMAT_PCM_32_BIT"
                    samplingRates="96000"
                    channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>

        <mixPort name="mixport_bus1_navigation_out" role="source">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>
        <mixPort name="mixport_bus2_voice_command_out" role="source">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>
        <mixPort name="mixport_bus3_call_ring_out" role="source">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>
        <mixPort name="mixport_bus4_call_out" role="source">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>
        <mixPort name="mixport_bus5_alarm_out" role="source">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>
        <mixPort name="mixport_bus6_notification_out" role="source">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>
        <mixPort name="mixport_bus7_system_sound_out" role="source">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
        </mixPort>
    </mixPorts>

    <devicePorts>
        <devicePort tagName="Built-In Mic" type="AUDIO_DEVICE_IN_BUILTIN_MIC" role="source" address="bottom_mic">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_IN_MONO AUDIO_CHANNEL_IN_STEREO"/>
        </devicePort>

        <!-- Native radio FM/DAB tuner source. The audio HAL captures this from the
             snd-aloop "Loopback" card (resolved by name in StreamPrimary; the CARD_7_DEV_1
             address mirrors the pinned snd_aloop.index=7, device 1 = capture side). -->
        <devicePort tagName="FM Tuner" type="AUDIO_DEVICE_IN_FM_TUNER" role="source" address="CARD_7_DEV_1">
            <profile format="AUDIO_FORMAT_PCM_16_BIT" samplingRates="48000" channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
        </devicePort>

        <devicePort tagName="bus0_media_out" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="bus0_media_out">
            <!-- Quad: front + rear DAC -->
            <profile format="AUDIO_FORMAT_PCM_32_BIT"
                    samplingRates="96000"
                    channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
            <gains>
                <gain name="gain_bus0_media"
                    mode="AUDIO_GAIN_MODE_JOINT"
                    channelMasks="AUDIO_CHANNEL_OUT_STEREO"
                    minValueMB="-3600" maxValueMB="0" defaultValueMB="-1800" stepValueMB="60"/>
            </gains>
        </devicePort>

        <devicePort tagName="bus1_navigation_out" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="bus1_navigation_out">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
            <gains>
                <gain name="gain_bus1_nav" mode="AUDIO_GAIN_MODE_JOINT" channelMasks="AUDIO_CHANNEL_OUT_STEREO" minValueMB="-3600" maxValueMB="0" defaultValueMB="-1800" stepValueMB="60"/>
            </gains>
        </devicePort>

        <devicePort tagName="bus2_voice_command_out" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="bus2_voice_command_out">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
            <gains>
                <gain name="gain_bus2_voice" mode="AUDIO_GAIN_MODE_JOINT" channelMasks="AUDIO_CHANNEL_OUT_STEREO" minValueMB="-3600" maxValueMB="0" defaultValueMB="-1800" stepValueMB="60"/>
            </gains>
        </devicePort>

        <devicePort tagName="bus3_call_ring_out" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="bus3_call_ring_out">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
            <gains>
                <gain name="gain_bus3_ring" mode="AUDIO_GAIN_MODE_JOINT" channelMasks="AUDIO_CHANNEL_OUT_STEREO" minValueMB="-3600" maxValueMB="0" defaultValueMB="-1800" stepValueMB="60"/>
            </gains>
        </devicePort>

        <devicePort tagName="bus4_call_out" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="bus4_call_out">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
            <gains>
                <gain name="gain_bus4_call" mode="AUDIO_GAIN_MODE_JOINT" channelMasks="AUDIO_CHANNEL_OUT_STEREO" minValueMB="-3600" maxValueMB="0" defaultValueMB="-1800" stepValueMB="60"/>
            </gains>
        </devicePort>

        <devicePort tagName="bus5_alarm_out" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="bus5_alarm_out">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
            <gains>
                <gain name="gain_bus5_alarm" mode="AUDIO_GAIN_MODE_JOINT" channelMasks="AUDIO_CHANNEL_OUT_STEREO" minValueMB="-3600" maxValueMB="0" defaultValueMB="-1800" stepValueMB="60"/>
            </gains>
        </devicePort>

        <devicePort tagName="bus6_notification_out" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="bus6_notification_out">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
            <gains>
                <gain name="gain_bus6_notif" mode="AUDIO_GAIN_MODE_JOINT" channelMasks="AUDIO_CHANNEL_OUT_STEREO" minValueMB="-3600" maxValueMB="0" defaultValueMB="-1800" stepValueMB="60"/>
            </gains>
        </devicePort>

        <devicePort tagName="bus7_system_sound_out" role="sink" type="AUDIO_DEVICE_OUT_BUS" address="bus7_system_sound_out">
            <profile format="AUDIO_FORMAT_PCM_32_BIT" samplingRates="96000" channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
            <gains>
                <gain name="gain_bus7_sys" mode="AUDIO_GAIN_MODE_JOINT" channelMasks="AUDIO_CHANNEL_OUT_STEREO" minValueMB="-3600" maxValueMB="0" defaultValueMB="-1800" stepValueMB="60"/>
            </gains>
        </devicePort>
    </devicePorts>

    <routes>
        <route type="mix" sink="primary input" sources="Built-In Mic"/>
        <route type="mix" sink="fm_tuner input" sources="FM Tuner"/>
        <route type="mix" sink="bus0_media_out" sources="mixport_bus0_media_out"/>
        <route type="mix" sink="bus1_navigation_out" sources="mixport_bus1_navigation_out"/>
        <route type="mix" sink="bus2_voice_command_out" sources="mixport_bus2_voice_command_out"/>
        <route type="mix" sink="bus3_call_ring_out" sources="mixport_bus3_call_ring_out"/>
        <route type="mix" sink="bus4_call_out" sources="mixport_bus4_call_out"/>
        <route type="mix" sink="bus5_alarm_out" sources="mixport_bus5_alarm_out"/>
        <route type="mix" sink="bus6_notification_out" sources="mixport_bus6_notification_out"/>
        <route type="mix" sink="bus7_system_sound_out" sources="mixport_bus7_system_sound_out"/>
        <route type="mix" sink="bus0_media_out" sources="primary output"/>
    </routes>
</module>
