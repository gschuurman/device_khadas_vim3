<?xml version="1.0" encoding="UTF-8"?>
<module name="primary" halVersion="3.0">

    <mixPorts>
        <mixPort name="primary_output"
                 role="source"
                 flags="AUDIO_OUTPUT_FLAG_PRIMARY">
            <profile format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="44100,48000"
                     channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </mixPort>
    </mixPorts>

    <devicePorts>
        <!-- Automotive bus device required by CarAudioService -->
        <devicePort tagName="bus0_media_out"
                    role="sink"
                    type="AUDIO_DEVICE_OUT_BUS"
                    address="bus0_media_out"/>
    </devicePorts>

    <routes>
        <route type="mix"
               sink="bus0_media_out"
               sources="primary_output"/>
    </routes>
</module>
