package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libfmdemod",
    vendor_available: true,
    host_supported: true,
    srcs: [
        "FmDemod.cpp",
        "Rds.cpp",
    ],
    local_include_dirs: ["include"],
    export_include_dirs: ["include"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-O3",
        "-ffast-math",
    ],
}

// Host test: synthetic stereo + RDS broadcast through the demodulator (`atest fmdemod_test`, or
// `m fmdemod_test && out/host/linux-x86/nativetest64/fmdemod_test/fmdemod_test`).
cc_test_host {
    name: "fmdemod_test",
    srcs: ["tests/fmdemod_test.cpp"],
    static_libs: ["libfmdemod"],
    gtest: false,
    cflags: ["-Wall", "-Wextra", "-Werror", "-O2"],
}
