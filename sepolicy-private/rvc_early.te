# Rear view camera while Android boots (packages/apps/RearViewCamera/early): reads the gear from the
# VHAL, streams the rear camera (as AID_AUTOMOTIVE_EVS) into a car display proxy layer.
type rvc_early, domain, coredomain;
type rvc_early_exec, exec_type, file_type, system_file_type;
init_daemon_domain(rvc_early)

binder_use(rvc_early)
hal_client_domain(rvc_early, hal_vehicle)

allow rvc_early fwk_automotive_display_service:service_manager find;
binder_call(rvc_early, automotive_display_service)

allow rvc_early cameraserver_service:service_manager find;
binder_call(rvc_early, cameraserver)
# The camera streams into the proxy's buffer queue, which lives in the proxy process.
binder_call(cameraserver, automotive_display_service)

get_prop(rvc_early, rvc_config_prop)

# Logs to the kernel log too (logd may not run yet this early in boot).
allow rvc_early kmsg_device:chr_file w_file_perms;

# cardisplayproxyd (platform automotive_display_service) looks up the GPU at startup.
allow automotive_display_service gpu_device:dir r_dir_perms;
