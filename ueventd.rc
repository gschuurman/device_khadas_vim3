modalias_handling enabled

subsystem usbmisc
    devname uevent_devname

# Bluetooth
/dev/rfkill                                                                  0660   bluetooth  bluetooth

/dev/mali0	0666 system graphics
/dev/dma_heap/system      0666   system     graphics
/dev/dma_heap/linux,cma   0666   system     graphics
/dev/dma_heap/reserved    0666   system     graphics
/dev/dri/card0            0660   system     graphics
/dev/dri/card1            0660   system     graphics
/dev/dri/card2            0660   system     graphics
/dev/dri/renderD128       0666   system     graphics
/dev/cec0	0666 system graphics
/dev/i2c-0	0666 system system
/dev/nanohub              0660   system     system
/dev/nanohub_comms        0660   system     system

# Group 'usb' (not 'system') so vendor USB HALs running as that group can open
# device nodes (e.g. the RTL-SDR BroadcastRadio HAL, user audioserver group usb).
# Owner stays 'system' so the AAOS USB host framework keeps access as owner.
/dev/bus/usb/*/*          0660   system     usb

/dev/video0               0660   system     camera
/dev/video1               0660   system     camera
/dev/video2               0660   system     camera
/dev/video3               0660   system     camera

# Storage: for factory reset protection feature
/dev/block/by-name/frp                                 0660    system       system

/sys/class/udc*                          current_speed 0644    system       system

# VIM3: let system_server (PhoneWindowManager) toggle the head-unit touchscreen's
# wake-inhibit, so the physical power button can disable tap-to-wake while injected
# keyevent 26 (burn-in screen-off) keeps it. The USB-HID path is the onboard
# WaveShare touch (vid 0EEF); trailing * matches the volatile inputN.
/sys/devices/platform/soc/ffe09000.usb/ff500000.usb/xhci-hcd.1.auto/usb1/1-1/1-1.4/1-1.4.1/1-1.4.1:1.0/0003:0EEF:0005.0001/input/input* inhibited 0664 system system

/dev/ttyAML*  0660  system  system
