# Extra permissions for the RTL-SDR backed BroadcastRadio HAL. It reuses the AOSP
# hal_broadcastradio_default domain (our binary is labeled hal_broadcastradio_default_exec
# in sepolicy-vendor/file_contexts), but unlike the mock default it talks to real hardware:
# the RTL-SDR dongle over USB.
allow hal_broadcastradio_default usb_device:dir r_dir_perms;
allow hal_broadcastradio_default usb_device:chr_file rw_file_perms;

# libusb (via librtlsdr) enumerates through sysfs (statfs /sys, /sys/bus/usb/devices/*/{busnum,devnum,
# descriptors}; the usb device dirs carry wakeup-related sysfs labels) and listens for hotplug on a uevent socket.
allow hal_broadcastradio_default sysfs:filesystem getattr;
r_dir_file(hal_broadcastradio_default, sysfs_type)
allow hal_broadcastradio_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# DeviceManager raises its worker thread priority (setpriority -19).
allow hal_broadcastradio_default self:capability sys_nice;

# Decoded PCM goes into the snd-aloop Loopback card (card pinned to 7 by snd_aloop.index=7, BoardConfig.mk).
# A platform neverallow (system/sepolicy/private/hal_audio.te) keeps every non-audio HAL off audio_device:chr_file,
# so the playback node the radio writes (pcmC7D0p) gets its own type; the capture side (pcmC7D1c) the audio HAL
# reads stays audio_device. LoopbackSink finds the card by name in /proc/asound/cards.
type radio_loopback_device, dev_type;
allow hal_broadcastradio_default audio_device:dir r_dir_perms;
allow hal_broadcastradio_default radio_loopback_device:chr_file rw_file_perms;
allow hal_broadcastradio_default proc_asound:file r_file_perms;
