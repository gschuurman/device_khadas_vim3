# --- PWM Backlight & GPIO ---
/sys/class/pwm/pwmchip[0-9]+/pwm[0-9]+/duty_cycle    u:object_r:vendor_sysfs_pwm:s0
/sys/class/pwm/pwmchip[0-9]+/pwm[0-9]+/enable        u:object_r:vendor_sysfs_pwm:s0
/sys/class/pwm/pwmchip[0-9]+/pwm[0-9]+/period        u:object_r:vendor_sysfs_pwm:s0
/sys/class/pwm/pwmchip[0-9]+/export                  u:object_r:vendor_sysfs_pwm:s0
/sys/class/pwm/pwmchip[0-9]+/unexport                u:object_r:vendor_sysfs_pwm:s0

/dev/gpiochip[0-9]+                                  u:object_r:vendor_gpio_device:s0

# --- Vehicle HAL (Schuurman) ---
/vendor/bin/hw/android\.hardware\.automotive\.vehicle@schuurman-service    u:object_r:vendor_vehicle_schuurman_exec:s0
/vendor/bin/init\.vehicle\.sh                                            u:object_r:vendor_vehicle_setup_exec:s0

# --- Sensors (BH1750 Light Sensor) ---
/vendor/bin/bh1750d                         u:object_r:bh1750d_exec:s0
/data/vendor/sensors(/.*)?                  u:object_r:vendor_sensor_data_file:s0


/system_ext/bin/hw/android\.hardware\.automotive\.audiocontrol-service   u:object_r:audiocontrol_service_exec:s0