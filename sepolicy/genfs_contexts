# PWM controller at ffd19000
genfscon sysfs /devices/platform/soc/ffd00000.bus/ffd19000.pwm/pwm/pwmchip  u:object_r:vendor_sysfs_pwm:s0
genfscon sysfs /devices/platform/soc/ffd00000.bus/ffd19000.pwm/export       u:object_r:vendor_sysfs_pwm:s0

# VPU (GPU/display) — hal_thermal needs sysfs_thermal; vhal + apps need sysfs_vpu for DPMS and uevent
genfscon sysfs /devices/virtual/thermal                              u:object_r:sysfs_thermal:s0
genfscon sysfs /devices/platform/soc/ff900000.vpu                   u:object_r:sysfs_vpu:s0
# NPU (etnaviv): libdrm's device enumeration in every GL/Vulkan client reads the DRM device's
# uevent; label it like the Mali GPU's sysfs so apps don't hit sysfs denials
genfscon sysfs /devices/platform/etnaviv                              u:object_r:sysfs_gpu:s0
# ACC wake source (gpio-keys-wake): system_suspend reads every /sys/class/wakeup/*/ stat
genfscon sysfs /devices/platform/gpio-keys-wake/wakeup               u:object_r:sysfs_wakeup:s0
