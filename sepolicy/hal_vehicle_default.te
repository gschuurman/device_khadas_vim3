type vendor_vehicle_schuurman, domain;
type vendor_vehicle_schuurman_exec, exec_type, vendor_file_type, file_type;

type vendor_gpio_device, dev_type;
type vendor_sysfs_pwm, fs_type, sysfs_type;

vendor_internal_prop(vendor_vehicle_prop)

init_daemon_domain(vendor_vehicle_schuurman)
hal_server_domain(vendor_vehicle_schuurman, hal_vehicle)

allow vendor_vehicle_schuurman vendor_gpio_device:chr_file rw_file_perms;
allow vendor_vehicle_schuurman vendor_sysfs_pwm:file rw_file_perms;
allow vendor_vehicle_schuurman sysfs:dir r_dir_perms;

get_prop(vendor_vehicle_schuurman, vendor_vehicle_prop)