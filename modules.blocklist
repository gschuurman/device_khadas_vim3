blocklist btsdio
# Installed as /vendor_dlkm/lib/modules/modules.blocklist by device.mk (the inline kernel build ignores
# BOARD_VENDOR_KERNEL_MODULES_BLOCKLIST). libmodprobe only accepts the "blocklist" keyword.
#
# etnaviv (the A311D's Vivante VIPNano NPU): loaded by init.vim3.rc on boot instead, after panfrost (GPU)
# and meson-drm (display) have their nodes. Coldboot loads modules in parallel, and minigbm's gbm_mesa takes
# the first render node as the GPU: an NPU on renderD128 would break graphics.
blocklist etnaviv
