<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:background="@color/status_icon_panel_bg_color">
    <com.android.car.ui.FocusParkingView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.android.car.ui.FocusArea
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/car_quick_controls_footer_button_margin_top"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/qc_display_footer_buttons">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.android.systemui.car.qc.SystemUIQCView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        app:remoteQCProvider="content://com.android.car.settings.qc/brightness_slider_with_icon"/>
                    <com.android.systemui.car.qc.SystemUIQCView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        app:remoteQCProvider="content://com.android.car.settings.qc/adaptive_brightness_switch"/>
                    <com.android.systemui.car.qc.SystemUIQCView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        app:remoteQCProvider="content://com.android.car.settings.qc/theme_toggle"/>
                    <com.android.systemui.car.qc.SystemUIQCView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        app:remoteQCProvider="content://com.android.car.carlauncher.calmmode/calm_mode"/>
                </LinearLayout>
            </ScrollView>

            <!-- Two-button footer: Screen Off (left) | Display Settings (right) -->
            <LinearLayout
                android:id="@+id/qc_display_footer_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/car_quick_controls_footer_button_margin_bottom"
                android:layout_marginHorizontal="@dimen/car_quick_controls_footer_button_horizontal_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Screen off button: sends a protected broadcast to the privileged
                     ScreenOffService (device/khadas/vim3/apps/ScreenOffService) which
                     calls PowerManager.goToSleep() with DEVICE_POWER permission. -->
                <com.android.systemui.car.qc.QCFooterButton
                    android:id="@+id/qc_screen_off_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/car_quick_controls_footer_button_min_height"
                    android:gravity="center"
                    style="@style/QCFooterButtonStyle"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="0dp"
                    android:text="@string/qc_screen_off"
                    app:intent="intent:#Intent;action=com.schuurman.vim3.action.SCREEN_OFF;package=com.schuurman.vim3.screenoff;component=com.schuurman.vim3.screenoff/.ScreenOffActivity;launchFlags=0x10000000;end"/>

                <!-- Display settings button -->
                <com.android.systemui.car.qc.QCFooterButton
                    android:id="@+id/qc_display_footer_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/car_quick_controls_footer_button_min_height"
                    android:gravity="center"
                    style="@style/QCFooterButtonStyle"
                    android:layout_marginBottom="0dp"
                    android:layout_marginHorizontal="0dp"
                    android:text="@string/qc_footer_display_settings"
                    app:intent="intent:#Intent;action=android.settings.DISPLAY_SETTINGS;launchFlags=0x14000000;end"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.android.car.ui.FocusArea>
</FrameLayout>
