<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->
<resources>
    <integer name="config_shortPressOnPowerBehavior">1</integer>

    <!-- Control the behavior when the user long presses the power button.
            0 - Nothing
            1 - Global actions menu
            2 - Power off (with confirmation)
            3 - Power off (without confirmation)
            4 - Go to voice assist
    -->
    <integer name="config_longPressOnPowerBehavior">3</integer>

    <!-- Allow a power-button long press to run the long-press action (power off)
         even when the device is non-interactive (asleep). The head unit sleeps on
         ACC-low, then the Pi Pico long-presses the physical power button to power
         off; with the default (false) that long press would only wake the screen. -->
    <bool name="config_supportLongPressPowerWhenNonInteractive">true</bool>

    <!-- Disable lockscreen sound effect -->
    <integer name="def_lockscreen_sounds_enabled">0</integer>

    <!-- This device is not "voice capable"; it's data-only. -->
    <bool name="config_voice_capable">false</bool>

    <!-- This device does not allow sms service. -->
    <bool name="config_sms_capable">false</bool>

    <!-- Separate software navigation bar required on this device. -->
    <bool name="config_showNavigationBar">true</bool>
    <integer name="config_navBarInteractionMode">0</integer>
    
    <bool name="config_useFixedVolume">false</bool>
    <bool name="config_single_volume">false</bool>
    <integer name="config_audio_vol_steps">100</integer>

    <string-array name="config_locationProviderPackageNames" translatable="false">
        <item>com.google.android.gms</item>
        <item>org.microg.nlp.backend.ichnaea</item>
        <item>org.microg.nlp.backend.nominatim</item>
    </string-array>

    <string-array name="config_webViewProviderPackages" translatable="false">
        <item>com.google.android.webview</item>
        <item>com.android.webview</item>
    </string-array>

    <string name="config_webViewPackageName" translatable="false">com.google.android.webview</string>
    <bool name="config_wifi_disable_bt_coexistence_scan_mode">false</bool>
    <bool name="config_wifi_bt_coex_scan_low_latency_enabled">true</bool>
    <bool name="config_wifi_softap_24ghz_supported">false</bool>
    <bool name="config_wifi_softap_5ghz_supported">true</bool>

    <!-- Boost 5GHz preference for Station mode -->
    <integer name="config_wifi_framework_5GHz_preference_boost_factor">50</integer>
    
    <!-- Enable 5GHz band for Auto-selection (Band 1 is 5GHz in most AOSP builds) -->
    <integer name="config_wifi_softap_band">1</integer>

    <!-- Enable Wi-Fi Direct (P2P) -->
    <bool name="config_wifi_p2p_support">true</bool>

    <!-- Support for P2P Concurrency (Station + P2P simultaneously) -->
    <!-- This is critical for Android Auto Wireless to work while connected to a hotspot -->
    <bool name="config_wifi_p2p_device_concurrency_supported">true</bool>

    <!-- Use a specific P2P interface name (matches the p2p0 in your device.mk) -->
    <string name="config_wifi_p2p_interface_name" translatable="false">p2p0</string>

    <!-- Enable P2P MAC randomization for privacy (required for Android 14+) -->
    <bool name="config_wifi_p2p_mac_randomization_supported">true</bool>

    <!-- For Automotive: Allows the framework to auto-accept P2P connections 
         if the phone was already paired via Bluetooth -->
    <bool name="config_wifi_p2p_support_numeric_pin_entry">true</bool>

    <bool name="config_vdmEnabled">true</bool>
    
    <bool name="config_carNightGlobalSetting">true</bool>
    <bool name="config_uiThemeToggle">true</bool>
    
    <string name="config_deviceConfiguratorPackageName" translatable="false">com.google.android.gms</string>
</resources>
