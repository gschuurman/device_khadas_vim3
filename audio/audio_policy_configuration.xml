<?xml version="1.0" encoding="UTF-8"?>
<audioPolicyConfiguration version="1.0">
    <globalConfiguration speaker_drc_enabled="false"/>

    <modules>
        <module name="primary" halVersion="2.0">
            <attachedDevices>
                <item>USB Device Out</item>
                <item>Built-In Mic</item>
            </attachedDevices>
            
            <defaultOutputDevice>USB Device Out</defaultOutputDevice>

            <mixPorts>
                <mixPort name="primary output" role="source" flags="AUDIO_OUTPUT_FLAG_PRIMARY">
                    <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100,48000"
                             channelMasks="AUDIO_CHANNEL_OUT_QUAD"/>
                </mixPort>
                
                <mixPort name="primary input" role="sink">
                    <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                             samplingRates="44100,48000"
                             channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
                </mixPort>
            </mixPorts>

            <devicePorts>
                <devicePort tagName="USB Device Out" type="AUDIO_DEVICE_OUT_USB_DEVICE" role="sink"/>
                <devicePort tagName="Built-In Mic" type="AUDIO_DEVICE_IN_BUILTIN_MIC" role="source"/>
            </devicePorts>

            <routes>
                <route type="mix" sink="USB Device Out" sources="primary output"/>
                <route type="mix" sink="primary input" sources="Built-In Mic"/>
            </routes>
        </module>

        <xi:include href="a2dp_audio_policy_configuration.xml"/>
        <xi:include href="usb_audio_policy_configuration.xml"/>
    </modules>

    <xi:include href="audio_policy_volumes.xml"/>
    <xi:include href="default_volume_tables.xml"/>
</audioPolicyConfiguration>